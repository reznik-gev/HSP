#!/usr/bin/env bash
# hsp: install and run HSP on this Docker host (docs/0054, docs/0056, docs/0107).
#
#   sudo ./hsp-1.0.0/bin/hsp install            # from an unpacked release bundle
#   sudo hsp install hsp-1.0.0.tar.gz [--dir /opt/hsp]
#   hsp status
#   sudo hsp backup now | list
#   sudo hsp restore <backup>
#   sudo ./hsp-1.1.0/bin/hsp upgrade            # the new release's hsp upgrades /opt/hsp
#   sudo hsp rollback
#   hsp help
#
# It ships in the release bundle, and `hsp install` copies it to <installation>/bin/hsp. It
# needs only bash, Docker with the Compose plugin, openssl and the usual tools (tar, sha256sum).
# Real work, such as backups, runs inside HSP's own images.
set -euo pipefail

readonly DEFAULT_DIR=/opt/hsp
readonly DEFAULT_DATA_DIR=/var/lib/hsp
# The containers' users (docs/0097, docs/0106): nginx in hsp-web, and postgres and backup.
readonly WEB_UID=101 POSTGRES_UID=999
# One file each in secrets/ (docs/0099, docs/0106).
readonly PASSWORDS=(db_superuser_password hsp_database_password keycloak_db_password
  keycloak_admin_password hsp_oidc_client_secret)
readonly EMPTY_SECRETS=(backup_s3_access_key backup_s3_secret_key)

# --- Small helpers -------------------------------------------------------------------------

die() {
  echo "hsp: $*" >&2
  exit 1
}
step() { echo "== $*"; }
ok() { echo "   $*"; }

need_root() { [[ $EUID -eq 0 ]] || die "$1 changes files only root may change: run it with sudo"; }

need_docker() {
  command -v docker >/dev/null || die "Docker isn't installed"
  docker compose version >/dev/null 2>&1 || die "Docker's Compose plugin isn't installed"
  docker info >/dev/null 2>&1 || die "can't reach Docker: is it running, and may you use it?"
}

# The installation this copy of hsp works on: HSP_DIR; else the folder above bin/ when that is an
# installation; else /opt/hsp (when run from a bundle, as for hsp upgrade). That applies to every
# command, so hsp status run from a bundle looks at /opt/hsp too.
installation() {
  local here dir
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [[ -n "${HSP_DIR:-}" ]]; then
    dir="$HSP_DIR"
  elif [[ -f "$here/.env" ]]; then
    dir="$here" # this is the installation's own bin/hsp
  else
    dir="$DEFAULT_DIR" # run from a bundle, e.g. for hsp upgrade
  fi
  [[ -f "$dir/.env" && -f "$dir/compose.yml" ]] ||
    die "$dir isn't an HSP installation; use --dir or HSP_DIR, or the installation's bin/hsp"
  echo "$dir"
}

compose() { docker compose --project-directory "$INSTALL_DIR" "$@"; }

# env_get <name>: a setting from the installation's .env.
env_get() { sed -n "s/^$1=//p" "$INSTALL_DIR/.env" | tail -n 1; }

# env_set <file> <name> <value>: change a setting, or add it.
env_set() {
  local file="$1" name="$2" value="$3" escaped
  escaped="$(printf '%s' "$value" | sed 's/[\/&|]/\\&/g')"
  if grep -q "^$name=" "$file"; then
    sed -i "s|^$name=.*|$name=$escaped|" "$file"
  else
    printf '%s=%s\n' "$name" "$value" >>"$file"
  fi
}

# ask <prompt> <default>: a value from the operator, or the default without a terminal.
ask() {
  local answer
  if [[ -t 0 ]]; then
    read -r -p "$1${2:+ [$2]}: " answer
    echo "${answer:-$2}"
  else
    echo "$2"
  fi
}

random_secret() { openssl rand -base64 32 | tr -d '/+=\n'; }

# --- Release bundles -----------------------------------------------------------------------

# open_bundle <.tar.gz or folder, or empty for the bundle this hsp came from>: prints the
# unpacked, verified bundle folder.
open_bundle() {
  local source="$1" here
  if [[ -z "$source" ]]; then
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    [[ -f "$here/VERSION" && -d "$here/images" ]] ||
      die "name the bundle: hsp $COMMAND <hsp-version.tar.gz or its unpacked folder>"
    source="$here"
  fi
  if [[ -f "$source" ]]; then
    if [[ -f "$source.sha256" ]]; then
      (cd "$(dirname "$source")" && sha256sum --quiet -c "$(basename "$source").sha256") ||
        die "$source doesn't match its .sha256 file: download it again"
    fi
    local unpacked
    unpacked="$(mktemp -d /var/tmp/hsp-bundle.XXXXXX)"
    echo "$unpacked" >>"$UNPACKED_LIST"
    tar -C "$unpacked" -xzf "$source" || die "can't unpack $source"
    source="$(find "$unpacked" -mindepth 1 -maxdepth 1 -type d -name 'hsp-*' | head -n 1)"
  fi
  [[ -f "$source/VERSION" && -f "$source/SHA256SUMS" ]] || die "$source isn't an HSP bundle"
  (cd "$source" && sha256sum --quiet -c SHA256SUMS) ||
    die "the bundle's files don't match SHA256SUMS: it's damaged, download it again"
  echo "$source"
}

load_images() {
  local image
  for image in "$1"/images/*.tar; do
    docker load -q -i "$image" >/dev/null || die "can't load $image"
  done
}

# --- Waiting for the stack -----------------------------------------------------------------

# Until every service is healthy and migrate has finished; up to 5 minutes.
wait_healthy() {
  local states
  for _ in $(seq 60); do
    states="$(compose ps -a --format '{{.Service}}={{.State}}/{{.Health}}/{{.ExitCode}}')"
    if [[ "$states" == *"migrate=exited//0"* ]] &&
      ! grep -v '^migrate=' <<<"$states" | grep -qv '=running/healthy/'; then
      return 0
    fi
    if grep -qE '=exited//[1-9]|=running/unhealthy/' <<<"$states"; then break; fi
    sleep 5
  done
  compose ps -a >&2
  compose logs --tail 40 >&2
  die "the stack didn't become healthy; the logs above say why"
}

# --- hsp install ---------------------------------------------------------------------------

usage_install() {
  cat <<'EOF'
hsp install [bundle] [options]: install HSP from a release bundle (docs/0107).

  bundle                 hsp-<version>.tar.gz or its unpacked folder; default: the bundle this
                         hsp came from
  --dir DIR              the installation folder (default /opt/hsp)
  --data-dir DIR         PostgreSQL's data and the backups (default /var/lib/hsp)
  --public-url URL       where users reach HSP, e.g. https://hsp.example.com
  --tls on|off           on: HSP serves HTTPS with --tls-cert and --tls-key (or a self-signed
                         certificate, for trying it out); off: a proxy in front does
  --tls-cert FILE        the certificate, with its chain
  --tls-key FILE         its private key
  --admin-email EMAIL    the first admin's email, which is also their username
  --admin-name NAME      the first admin's name
  --no-admin             don't create a first admin
  --set NAME=VALUE       any other .env setting (repeatable), e.g. --set HSP_HTTPS_PORT=8443
  --secrets DIR          use a saved secrets/ folder instead of new secrets, to restore a backup
                         on a new host (install.md, "Recovering on a new host")
EOF
}

cmd_install() {
  local bundle="" dir="$DEFAULT_DIR" data_dir="$DEFAULT_DATA_DIR" public_url="" tls=""
  local tls_cert="" tls_key="" admin_email="" admin_name="" admin=1 secrets_from=""
  local -a settings=()
  while (($#)); do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --data-dir) data_dir="$2"; shift 2 ;;
      --public-url) public_url="$2"; shift 2 ;;
      --tls) tls="$2"; shift 2 ;;
      --tls-cert) tls_cert="$2"; shift 2 ;;
      --tls-key) tls_key="$2"; shift 2 ;;
      --admin-email) admin_email="$2"; shift 2 ;;
      --admin-name) admin_name="$2"; shift 2 ;;
      --no-admin) admin=""; shift ;;
      --set) settings+=("$2"); shift 2 ;;
      --secrets) secrets_from="$2"; shift 2 ;;
      -h | --help) usage_install; return 0 ;;
      -*) die "unknown option $1 (hsp install --help)" ;;
      *) bundle="$1"; shift ;;
    esac
  done
  need_root "hsp install"
  need_docker
  [[ ! -e "$dir/.env" ]] || die "$dir already holds an installation: use hsp upgrade"

  public_url="${public_url:-$(ask "Where users reach HSP" "")}"
  [[ "$public_url" =~ ^https?://[^/]+$ ]] ||
    die "--public-url must be like https://hsp.example.com, without a path or trailing slash"
  tls="${tls:-$(ask "Does HSP serve HTTPS itself (on), or a proxy in front (off)?" on)}"
  [[ "$tls" == on || "$tls" == off ]] || die "--tls is on or off"
  if [[ -n "$admin" ]]; then
    admin_email="${admin_email:-$(ask "The first admin's email" "")}"
    [[ "$admin_email" == *@* ]] || die "the first admin needs an email (or use --no-admin)"
    admin_name="${admin_name:-$(ask "The first admin's name" "${admin_email%%@*}")}"
  fi

  step "Check the bundle"
  local source version
  source="$(open_bundle "$bundle")"
  version="$(cat "$source/VERSION")"
  ok "HSP $version, checksums match"

  step "Load the images"
  load_images "$source"
  ok "loaded"

  step "Write $dir"
  INSTALL_DIR="$dir"
  install -d -m 755 "$dir" "$dir/bin"
  install -d -m 700 "$dir/secrets"
  install -d -m 755 "$dir/tls"
  cp "$source/compose/compose.yml" "$source/compose/backups.example.yml" "$dir/"
  cp -r "$source/compose/postgres-init" "$dir/"
  cp "$source/compose/backups.example.yml" "$dir/backups.yml"
  cp "$source/compose/.env.example" "$dir/.env"
  install -m 755 "$source/bin/hsp" "$dir/bin/hsp"
  env_set "$dir/.env" HSP_VERSION "$version"
  env_set "$dir/.env" HSP_PUBLIC_URL "$public_url"
  env_set "$dir/.env" HSP_DATA_DIR "$data_dir"
  env_set "$dir/.env" HSP_WEB_TLS "$tls"
  local setting
  for setting in "${settings[@]}"; do
    [[ "$setting" == *=* ]] || die "--set needs NAME=VALUE, not $setting"
    env_set "$dir/.env" "${setting%%=*}" "${setting#*=}"
  done
  ok ".env, compose.yml, backups.yml and bin/hsp"

  # Readable by the containers that mount them; the folder keeps everyone else out
  # (deploy/README.md, step 2).
  local s
  if [[ -n "$secrets_from" ]]; then
    # Recovering on a new host (docs/0119): PostgreSQL takes its passwords from these on its
    # first start, so they must be the saved ones before it starts, not put back after.
    for s in "${PASSWORDS[@]}" hsp_session_encryption_key; do
      [[ -s "$secrets_from/$s" ]] || die "$secrets_from has no $s: --secrets needs a saved secrets/"
    done
    cp "$secrets_from"/* "$dir/secrets/"
    for s in "${EMPTY_SECRETS[@]}"; do [[ -e "$dir/secrets/$s" ]] || : >"$dir/secrets/$s"; done
    chmod 444 "$dir"/secrets/*
    ok "secrets/, from $secrets_from"
  else
    for s in "${PASSWORDS[@]}"; do random_secret >"$dir/secrets/$s"; done
    openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n' >"$dir/secrets/hsp_session_encryption_key"
    for s in "${EMPTY_SECRETS[@]}"; do : >"$dir/secrets/$s"; done
    chmod 444 "$dir"/secrets/*
    ok "secrets/, generated"
  fi

  if [[ "$tls" == on ]]; then
    if [[ -n "$tls_cert" || -n "$tls_key" ]]; then
      [[ -f "$tls_cert" && -f "$tls_key" ]] || die "--tls-cert and --tls-key must both be files"
      cp "$tls_cert" "$dir/tls/tls.crt"
      cp "$tls_key" "$dir/tls/tls.key"
      ok "tls/, from $tls_cert"
    else
      local host="${public_url#*://}"
      host="${host%%:*}"
      openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj "/CN=$host" \
        -addext "subjectAltName=DNS:$host" \
        -keyout "$dir/tls/tls.key" -out "$dir/tls/tls.crt" 2>/dev/null
      ok "tls/: a self-signed certificate for $host. Browsers will warn: replace tls.crt and"
      ok "tls.key with your own and run 'docker compose restart web' in $dir"
    fi
    chown "$WEB_UID" "$dir/tls/tls.key" && chmod 400 "$dir/tls/tls.key"
    chmod 444 "$dir/tls/tls.crt"
  fi

  install -d -m 755 "$data_dir"
  install -d -m 750 -o "$POSTGRES_UID" "$data_dir/backups"
  ok "$data_dir, with backups/ for the backup service"

  step "Start HSP"
  compose up -d
  wait_healthy
  ok "every service is healthy"

  if [[ -n "$admin" ]]; then
    step "The first admin"
    create_admin "$admin_email" "$admin_name"
  fi

  step "Done"
  echo "HSP $version is running at $public_url, from $dir."
  echo "Backups: $dir/backups.yml (every night by default, to $data_dir/backups). Check them"
  echo "with '$dir/bin/hsp status'."
}

# create_admin <email> <name>: a Keycloak user with the hsp-admin role and a one-time password.
create_admin() {
  local email="$1" name="$2" first last password
  first="${name%% *}"
  last="${name#"$first"}"
  last="${last# }"
  password="$(random_secret | cut -c1-16)"
  compose exec -T keycloak bash -s -- "$email" "$first" "$last" "$password" <<'EOF' >/dev/null
set -euo pipefail
k=/opt/keycloak/bin/kcadm.sh
$k config credentials --server http://localhost:8080/auth --realm master --user admin \
  --password "$(cat /run/secrets/keycloak_admin_password)"
$k create users -r hsp -s "username=$1" -s "email=$1" -s "firstName=$2" -s "lastName=$3" \
  -s enabled=true -s emailVerified=true
$k set-password -r hsp --username "$1" --new-password "$4" --temporary
$k add-roles -r hsp --uusername "$1" --rolename hsp-admin
EOF
  ok "Sign in as $email with the one-time password $password"
  ok "Keycloak asks for a new password at the first sign-in."
}

# --- hsp status ----------------------------------------------------------------------------

cmd_status() {
  need_docker
  INSTALL_DIR="$(installation)"
  local data_dir
  data_dir="$(env_get HSP_DATA_DIR)"
  echo "HSP $(env_get HSP_VERSION) at $(env_get HSP_PUBLIC_URL), installed in $INSTALL_DIR"
  echo
  echo "Services:"
  compose ps -a --format '  {{.Service}}\t{{.State}}\t{{.Health}}' | column -t -s $'\t'
  echo
  echo "Backups:"
  backup_status
  echo
  echo "Free disk:"
  df -h --output=target,avail,pcent "${data_dir:-$DEFAULT_DATA_DIR}" \
    "${data_dir:-$DEFAULT_DATA_DIR}/backups" 2>/dev/null | sed 's/^/  /' || echo "  (unknown)"
}

# The last success and failure of each schedule, from the backup service's metrics.
backup_status() {
  local metrics
  if ! metrics="$(compose exec -T backup python -c \
    "import urllib.request; print(urllib.request.urlopen('http://localhost:9465/metrics').read().decode())" \
    2>/dev/null)"; then
    echo "  the backup service isn't running"
    return
  fi
  local found="" schedule success failure line
  while read -r schedule success failure; do
    found=1
    line="  $schedule: last backup $(when "$success")"
    if [[ -n "$failure" && "${failure%.*}" -gt "${success%.*}" ]]; then
      line+=", FAILED since $(when "$failure")"
    fi
    echo "$line"
  done < <(awk '
    /^hsp_backup_last_(success|failure)_timestamp_seconds\{/ {
      match($0, /schedule="[^"]*"/); s = substr($0, RSTART + 10, RLENGTH - 11)
      if ($0 ~ /success/) ok[s] = $2; else bad[s] = $2; seen[s] = 1
    }
    END { for (s in seen) print s, (s in ok ? ok[s] : 0), (s in bad ? bad[s] : 0) }
  ' <<<"$metrics" | sort)
  [[ -n "$found" ]] || echo "  none since the backup service started (see hsp backup list)"
}

when() {
  local seconds="${1%.*}"
  if [[ -z "$seconds" || "$seconds" == 0 ]]; then
    echo "never"
  else
    date -d "@$seconds" '+%Y-%m-%d %H:%M %Z'
  fi
}

# --- hsp backup and hsp restore ------------------------------------------------------------

# backup_tool <hsp-backup arguments>: in the running backup service, or in a one-off container
# of it while the service is stopped (docs/0106).
backup_tool() {
  if [[ -n "$(compose ps -q --status running backup 2>/dev/null)" ]]; then
    compose exec -T backup hsp-backup "$@"
  else
    compose run --rm -T --no-deps backup hsp-backup "$@"
  fi
}

cmd_backup() {
  need_root "hsp backup"
  need_docker
  INSTALL_DIR="$(installation)"
  case "${1:-}" in
    now) backup_tool now ;; # prints the new backup's name
    list) backup_tool list ;;
    *) die "hsp backup now | hsp backup list" ;;
  esac
}

cmd_restore() {
  local name="" yes=""
  while (($#)); do
    case "$1" in
      --yes) yes=1; shift ;;
      -*) die "unknown option $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "hsp restore <backup> [--yes]; hsp backup list shows the backups"
  need_root "hsp restore"
  need_docker
  INSTALL_DIR="$(installation)"
  # A typo shouldn't take HSP down: check the backup is there before stopping anything.
  backup_tool list | awk -v n="$name" '$1 == n { found = 1 } END { exit !found }' ||
    die "no backup is named $name; hsp backup list shows them"
  if [[ -z "$yes" ]]; then
    [[ -t 0 ]] || die "restoring replaces both databases; add --yes to go on without asking"
    echo "This replaces HSP's and Keycloak's databases with $name."
    echo "Everything changed since that backup is lost, and HSP is down while it runs."
    [[ "$(ask "Type yes to go on" "")" == yes ]] || die "nothing was changed"
  fi
  step "Stop HSP"
  compose stop api keycloak web backup
  step "Restore $name"
  local status=0
  backup_tool restore "$name" --yes || status=$?
  if ((status == 3)); then
    # Refused before touching a database (e.g. a backup from a newer HSP): nothing changed.
    step "Nothing was changed: start HSP again"
    compose up -d
    wait_healthy
    die "the restore was refused (see above); HSP is running as it was"
  elif ((status != 0)); then
    # A database may be half-restored: leave HSP stopped rather than serve it (docs/0118).
    echo "hsp: the restore failed partway; HSP is still stopped. Fix the cause above and run it again," >&2
    die "or start HSP as it is with: docker compose --project-directory $INSTALL_DIR up -d"
  fi
  step "Start HSP"
  compose up -d
  wait_healthy
  ok "every service is healthy"
}

# --- hsp upgrade and hsp rollback ----------------------------------------------------------

# version_cmp <a> <b>: prints -1, 0 or 1 (docs/0063). A release is newer than its own
# pre-releases: 1.1.0 > 1.1.0-rc.2 > 1.1.0-rc.1.
version_cmp() {
  local a_core="${1%%-*}" b_core="${2%%-*}" a_pre="" b_pre="" i
  [[ "$1" == *-* ]] && a_pre="${1#*-}"
  [[ "$2" == *-* ]] && b_pre="${2#*-}"
  local -a a b
  IFS=. read -r -a a <<<"$a_core"
  IFS=. read -r -a b <<<"$b_core"
  for i in 0 1 2; do
    if ((10#${a[i]:-0} != 10#${b[i]:-0})); then
      ((10#${a[i]:-0} < 10#${b[i]:-0})) && echo -1 || echo 1
      return
    fi
  done
  if [[ "$a_pre" == "$b_pre" ]]; then echo 0
  elif [[ -z "$a_pre" ]]; then echo 1
  elif [[ -z "$b_pre" ]]; then echo -1
  elif [[ "$(printf '%s\n%s\n' "$a_pre" "$b_pre" | sort -V | head -n 1)" == "$a_pre" ]]; then
    echo -1
  else echo 1
  fi
}

# check_upgrade_path <installed> <new>: no downgrades, and at most one MAJOR at a time (docs/0056).
check_upgrade_path() {
  local from="$1" to="$2"
  case "$(version_cmp "$to" "$from")" in
    0) die "HSP $from is already installed" ;;
    -1) die "$to is older than the installed $from; to go back, use hsp rollback" ;;
  esac
  local from_major="${from%%.*}" to_major="${to%%.*}"
  if ((10#$to_major > 10#$from_major + 1)); then
    die "an upgrade crosses one MAJOR version at most: install $((10#$from_major + 1)).x first"
  fi
}

# merge_env <installed .env> <new .env.example> <out>: the new example's settings with every
# value already set, plus settings the new example no longer has; prints what changed.
merge_env() {
  local old="$1" example="$2" out="$3" line name
  cp "$example" "$out"
  local -a kept=()
  while IFS= read -r line; do
    [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
    name="${BASH_REMATCH[1]}"
    if grep -q "^$name=" "$example"; then
      env_set "$out" "$name" "${line#*=}"
    else
      kept+=("$line")
    fi
  done <"$old"
  if ((${#kept[@]})); then
    printf '\n# Kept from before the upgrade: not in this release'"'"'s .env.example.\n' >>"$out"
    printf '%s\n' "${kept[@]}" >>"$out"
  fi
  while IFS= read -r line; do
    [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
    grep -q "^${BASH_REMATCH[1]}=" "$old" || ok "new setting: $line"
  done <"$example"
}

# missing_secrets <compose.yml> <installation>: the secret files the compose.yml names that the
# installation doesn't have.
missing_secrets() {
  grep -o 'file: \./secrets/[A-Za-z0-9_]*' "$1" | sed 's|file: \./secrets/||' | sort -u |
    while read -r s; do [[ -e "$2/secrets/$s" ]] || echo "$s"; done
}

usage_upgrade() {
  cat <<'EOF'
hsp upgrade [bundle] [--dir DIR] [--yes]: upgrade an installation to a release bundle (docs/0056).

Run the NEW release's hsp: sudo ./hsp-<new version>/bin/hsp upgrade
  bundle      hsp-<version>.tar.gz or its unpacked folder; default: the bundle this hsp came from
  --dir DIR   the installation (default /opt/hsp, or HSP_DIR)
  --yes       don't ask

It takes a backup first and aborts if that fails. HSP is down for a few minutes while the
database is migrated. If anything goes wrong, hsp rollback brings back the previous release and
its data from that backup.
EOF
}

cmd_upgrade() {
  local bundle="" yes=""
  while (($#)); do
    case "$1" in
      --dir) HSP_DIR="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      -h | --help) usage_upgrade; return 0 ;;
      -*) die "unknown option $1 (hsp upgrade --help)" ;;
      *) bundle="$1"; shift ;;
    esac
  done
  need_root "hsp upgrade"
  need_docker
  INSTALL_DIR="$(installation)"
  local from to source
  from="$(env_get HSP_VERSION)"

  step "Check the bundle"
  source="$(open_bundle "$bundle")"
  to="$(cat "$source/VERSION")"
  check_upgrade_path "$from" "$to"
  local missing
  missing="$(missing_secrets "$source/compose/compose.yml" "$INSTALL_DIR")"
  [[ -z "$missing" ]] ||
    die "HSP $to needs secret files this installation doesn't have: $missing. Its release notes say how to make them."
  ok "HSP $from -> $to, checksums match"
  if [[ -z "$yes" ]]; then
    [[ -t 0 ]] || die "an upgrade stops HSP for a few minutes; add --yes to go on without asking"
    [[ "$(ask "Upgrade $INSTALL_DIR to $to? HSP is down for a few minutes. Type yes" "")" == yes ]] ||
      die "nothing was changed"
  fi

  step "Load the images"
  load_images "$source"
  ok "loaded"

  step "Back up first"
  local backup
  backup="$(backup_tool now --schedule pre-upgrade)" ||
    die "the pre-upgrade backup failed, so nothing was changed: fix the cause above first"
  ok "$backup"

  step "Keep the previous release for hsp rollback"
  local previous="$INSTALL_DIR/previous"
  rm -rf "$previous"
  install -d -m 700 "$previous"
  cp -a "$INSTALL_DIR/.env" "$INSTALL_DIR/compose.yml" "$INSTALL_DIR/postgres-init" "$previous/"
  cp -a "$INSTALL_DIR/bin" "$previous/"
  echo "$backup" >"$previous/backup"
  echo "$from" >"$previous/version"
  ok "$previous"

  step "Stop the API: users see that HSP is being updated"
  compose stop api

  step "Write HSP $to's files"
  cp "$source/compose/compose.yml" "$source/compose/backups.example.yml" "$INSTALL_DIR/"
  rm -rf "$INSTALL_DIR/postgres-init" && cp -r "$source/compose/postgres-init" "$INSTALL_DIR/"
  merge_env "$previous/.env" "$source/compose/.env.example" "$INSTALL_DIR/.env.new"
  env_set "$INSTALL_DIR/.env.new" HSP_VERSION "$to"
  mv "$INSTALL_DIR/.env.new" "$INSTALL_DIR/.env"
  install -m 755 "$source/bin/hsp" "$INSTALL_DIR/bin/hsp"
  ok ".env keeps every value you set; backups.yml is unchanged"

  step "Migrate and start HSP $to"
  if ! compose up -d --remove-orphans || ! wait_healthy; then
    echo "hsp: HSP $to didn't start. 'sudo $INSTALL_DIR/bin/hsp rollback' brings back $from" >&2
    die "and its data from $backup"
  fi
  ok "every service is healthy"

  # The backup from the upgrade before this one is no longer needed (docs/0106).
  backup_tool prune --schedule pre-upgrade --keep 1 >/dev/null ||
    ok "older pre-upgrade backups weren't deleted; hsp backup list shows them"
  step "Done"
  echo "HSP $to is running. The images of $from are kept; 'docker image prune -a' removes"
  echo "unused ones once you're sure you won't roll back."
}

cmd_rollback() {
  local yes=""
  while (($#)); do
    case "$1" in
      --dir) HSP_DIR="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) die "hsp rollback [--dir DIR] [--yes]" ;;
    esac
  done
  need_root "hsp rollback"
  need_docker
  INSTALL_DIR="$(installation)"
  local previous="$INSTALL_DIR/previous"
  [[ -f "$previous/backup" && -f "$previous/version" ]] ||
    die "there's nothing to roll back to: no upgrade has kept a previous release here"
  local from to backup
  from="$(env_get HSP_VERSION)"
  to="$(cat "$previous/version")"
  backup="$(cat "$previous/backup")"
  if [[ -z "$yes" ]]; then
    [[ -t 0 ]] || die "rolling back replaces both databases; add --yes to go on without asking"
    echo "This goes back from HSP $from to $to, with the data from $backup."
    echo "Everything changed since that upgrade is lost."
    [[ "$(ask "Type yes to go on" "")" == yes ]] || die "nothing was changed"
  fi

  step "Stop HSP"
  compose stop api keycloak web backup migrate
  step "Bring back HSP $to's files"
  cp -a "$previous/.env" "$previous/compose.yml" "$INSTALL_DIR/"
  rm -rf "$INSTALL_DIR/postgres-init" && cp -a "$previous/postgres-init" "$INSTALL_DIR/"
  # A new file, not written over this running script: bash reads it as it goes.
  install -m 755 "$previous/bin/hsp" "$INSTALL_DIR/bin/hsp"
  step "Restore $backup"
  backup_tool restore "$backup" --yes ||
    die "the restore failed; HSP is stopped. Fix the cause above and run hsp rollback again"
  step "Start HSP $to"
  compose up -d --remove-orphans
  wait_healthy
  rm -rf "$previous"
  ok "HSP $to is running again, with the data from $backup"
}

# --- Commands ------------------------------------------------------------------------------

usage() {
  cat <<'EOF'
hsp: install and run HSP on this Docker host (docs/0107).

  hsp install [bundle] [options]   install from a release bundle (hsp install --help)
  hsp status                       version, services, last backups and free disk
  hsp backup now                   take a backup now (it goes where backups.yml's manual says)
  hsp backup list                  every backup on every target, newest first
  hsp restore <backup> [--yes]     replace both databases with a backup; HSP is down meanwhile
  hsp upgrade [bundle]             upgrade to a release; run the new release's hsp (--help)
  hsp rollback                     undo the last upgrade: the previous release and its data
  hsp help                         this
EOF
}

# Bundles unpacked into /var/tmp are removed on exit (open_bundle runs in a subshell, so it
# lists them in a file).
UNPACKED_LIST="$(mktemp)"
cleanup() {
  local d
  while read -r d; do [[ -n "$d" ]] && rm -rf "$d"; done <"$UNPACKED_LIST"
  rm -f "$UNPACKED_LIST"
}
trap cleanup EXIT

COMMAND="${1:-help}"
shift || true
case "$COMMAND" in
  install) cmd_install "$@" ;;
  # Not listed in help: the tests wait with it, so the rule lives in one place.
  wait)
    need_docker
    INSTALL_DIR="$(installation)"
    wait_healthy
    ;;
  status) cmd_status "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  rollback) cmd_rollback "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; die "unknown command $COMMAND" ;;
esac
