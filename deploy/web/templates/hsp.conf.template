# HSP web server (docs/0060, docs/0097). nginx's entrypoint renders this file with envsubst into
# /etc/nginx/conf.d/ at start, so ${VARIABLES} come from the container's environment.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Built assets have content hashes in their names: cache them for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: every other path is a client route, served by index.html, never cached
    # so a new release is picked up on the next page load.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

# Health for Docker and Kubernetes probes. Port 8081 is never published.
server {
    listen 8081;
    access_log off;

    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok","version":"${HSP_VERSION}"}';
    }
}
