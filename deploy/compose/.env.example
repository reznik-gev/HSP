# HSP installation settings (docs/0099). `hsp install` writes .env from this file.
# Secrets are NOT here: each is a file in secrets/, which only root can open (hsp install
# generates them; keep a copy, backups never include them):
#   db_superuser_password        PostgreSQL superuser (postgres, backup)
#   hsp_database_password        HSP's database role (postgres; api and migrate)
#   keycloak_db_password         Keycloak's database role (postgres; keycloak)
#   keycloak_admin_password      Keycloak's first admin, "admin" (keycloak)
#   hsp_session_encryption_key   Fernet key for stored tokens (api)
#   hsp_oidc_client_secret       the hsp-api OIDC client's secret (api, keycloak)
#   backup_s3_access_key         an S3 backup target's keys; empty files without one (backup)
#   backup_s3_secret_key

# The release whose images run (they're loaded from its bundle).
HSP_VERSION=1.0.0

# Where users reach HSP, without a trailing slash.
HSP_PUBLIC_URL=https://hsp.example.com

# PostgreSQL data, and later backups, live here (docs/0099).
HSP_DATA_DIR=/var/lib/hsp

# Published ports, and the host address to publish them on.
HSP_BIND_ADDRESS=0.0.0.0
HSP_HTTP_PORT=80
HSP_HTTPS_PORT=443

# TLS (docs/0098): on = hsp-web terminates TLS with tls/tls.crt and tls/tls.key;
# off = a proxy in front does, and HSP_TRUSTED_PROXIES lists its addresses.
HSP_WEB_TLS=on
HSP_HSTS=on
HSP_TRUSTED_PROXIES=

# Networks (CIDRs) allowed to open Keycloak's admin console at /auth/admin. Empty: none.
HSP_KEYCLOAK_ADMIN_FROM=

# API worker processes; 4 suits the recommended host (docs/install.md, Hardware).
HSP_API_WORKERS=4

# The API's log level. DEBUG adds each request's full path to its log line (docs/0105).
HSP_LOG_LEVEL=INFO

# Prometheus metrics (docs/0105). The API's are on this host address and port; the default lets
# only this host scrape them. Set an internal interface's address to let a Prometheus elsewhere in.
HSP_METRICS_ADDRESS=127.0.0.1
HSP_API_METRICS_PORT=9464
HSP_BACKUP_METRICS_PORT=9465

# Tracing (docs/0105), with the standard OpenTelemetry settings. Off while the endpoint is empty;
# spans go over OTLP/HTTP, e.g. http://otel-collector.example:4318. Without a sampler, 10% of
# requests are traced (parentbased_traceidratio, 0.1).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
