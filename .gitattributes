# Normalize text files to LF (see docs/0026-2026-10-08-line-endings.md)
* text=auto eol=lf

# Windows-native scripts
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.glb  binary
*.gltf text
*.pdf  binary
