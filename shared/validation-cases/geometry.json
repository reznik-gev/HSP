{
  "rule": "geometry: overlapping zones and nested zones outside their parent (errors), doors, columns and labels (warnings)",
  "zone_types": ["room"],
  "catalog": {
    "desk": { "id": "desk", "item_id": "i-desk", "key": "desk", "category": "desk", "name": "Desk", "shape": "box", "width_mm": 1600, "depth_mm": 800, "height_mm": 740, "color": null, "is_seat": true, "mountable": false, "attaches_to_categories": [], "footprint_blocks": true },
    "cabinet": { "id": "cabinet", "item_id": "i-cab", "key": "cabinet", "category": "storage", "name": "Cabinet", "shape": "box", "width_mm": 420, "depth_mm": 600, "height_mm": 600, "color": null, "is_seat": false, "mountable": false, "attaches_to_categories": [], "footprint_blocks": true },
    "chair": { "id": "chair", "item_id": "i-chair", "key": "chair", "category": "chair", "name": "Chair", "shape": "cylinder", "width_mm": 650, "depth_mm": 650, "height_mm": 1050, "color": null, "is_seat": false, "mountable": false, "attaches_to_categories": [], "footprint_blocks": false }
  },
  "cases": [
    {
      "name": "rooms that only share a wall line don't overlap",
      "plan": {
        "zones": [
          { "id": "a", "name": "A", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[0, 0], [4000, 0], [4000, 3000], [0, 3000]] },
          { "id": "b", "name": "B", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[4000, 0], [8000, 0], [8000, 3000], [4000, 3000]] }
        ]
      },
      "expect": []
    },
    {
      "name": "a room wholly inside a larger zone is fine, nested or not",
      "plan": {
        "zones": [
          { "id": "wing", "name": "Wing", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[0, 0], [10000, 0], [10000, 8000], [0, 8000]] },
          { "id": "room", "name": "Room", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[1000, 1000], [4000, 1000], [4000, 4000], [1000, 4000]] }
        ]
      },
      "expect": []
    },
    {
      "name": "two rooms overlapping partly: both are reported",
      "plan": {
        "zones": [
          { "id": "a", "name": "A", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[0, 0], [4000, 0], [4000, 3000], [0, 3000]] },
          { "id": "b", "name": "B", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[3000, 0], [7000, 0], [7000, 3000], [3000, 3000]] }
        ]
      },
      "expect": [
        { "code": "zone_overlap", "element_id": "a" },
        { "code": "zone_overlap", "element_id": "b" }
      ]
    },
    {
      "name": "an L-shaped room and a room in its corner, touching only along edges",
      "plan": {
        "zones": [
          { "id": "l", "name": "L", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[0, 0], [6000, 0], [6000, 3000], [3000, 3000], [3000, 6000], [0, 6000]] },
          { "id": "corner", "name": "Corner", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[3000, 3000], [6000, 3000], [6000, 6000], [3000, 6000]] }
        ]
      },
      "expect": []
    },
    {
      "name": "a room reaching into an L's corner",
      "plan": {
        "zones": [
          { "id": "l", "name": "L", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[0, 0], [6000, 0], [6000, 3000], [3000, 3000], [3000, 6000], [0, 6000]] },
          { "id": "room", "name": "Room", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[2000, 2000], [5000, 2000], [5000, 5000], [2000, 5000]] }
        ]
      },
      "expect": [
        { "code": "zone_overlap", "element_id": "l" },
        { "code": "zone_overlap", "element_id": "room" }
      ]
    },
    {
      "name": "a nested zone sticking out of its parent",
      "plan": {
        "zones": [
          { "id": "parent", "name": "Parent", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[0, 0], [4000, 0], [4000, 3000], [0, 3000]] },
          { "id": "child", "name": "Child", "zone_type_id": "room", "parent_zone_id": "parent", "boundary": [[3000, 0], [5000, 0], [5000, 2000], [3000, 2000]] }
        ]
      },
      "expect": [{ "code": "zone_outside_parent", "element_id": "child" }]
    },
    {
      "name": "nested zones inside their parents, down two levels, sharing the parents' edges",
      "plan": {
        "zones": [
          { "id": "wing", "name": "Wing", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[0, 0], [8000, 0], [8000, 6000], [0, 6000]] },
          { "id": "pod", "name": "Pod", "zone_type_id": "room", "parent_zone_id": "wing", "boundary": [[0, 0], [4000, 0], [4000, 3000], [0, 3000]] },
          { "id": "booth", "name": "Booth", "zone_type_id": "room", "parent_zone_id": "pod", "boundary": [[0, 0], [1000, 0], [1000, 1000], [0, 1000]] }
        ]
      },
      "expect": []
    },
    {
      "name": "a nested zone wholly outside its parent",
      "plan": {
        "zones": [
          { "id": "parent", "name": "Parent", "zone_type_id": "room", "parent_zone_id": null, "boundary": [[0, 0], [4000, 0], [4000, 3000], [0, 3000]] },
          { "id": "child", "name": "Child", "zone_type_id": "room", "parent_zone_id": "parent", "boundary": [[6000, 0], [8000, 0], [8000, 2000], [6000, 2000]] }
        ]
      },
      "expect": [{ "code": "zone_outside_parent", "element_id": "child" }]
    },
    {
      "name": "a cabinet in a door's swing; a chair there and a cabinet away from it are fine",
      "plan": {
        "walls": [{ "id": "w1", "a": [0, 0], "b": [4000, 0], "thickness_mm": 150, "height_mm": 3000 }],
        "openings": [
          { "id": "door", "wall_id": "w1", "type": "door", "offset_mm": 1000, "width_mm": 900, "height_mm": 2100, "sill_mm": 0, "swing": "left_in" }
        ],
        "objects": [
          { "id": "in-swing", "catalog_item_rev_id": "cabinet", "position": [1300, 500, 0], "rotation_ddeg": 0, "label": null, "attached_to": null, "device_id": null, "allocation_mode": null },
          { "id": "chair", "catalog_item_rev_id": "chair", "position": [1400, 400, 0], "rotation_ddeg": 0, "label": null, "attached_to": null, "device_id": null, "allocation_mode": null },
          { "id": "away", "catalog_item_rev_id": "cabinet", "position": [3000, 1500, 0], "rotation_ddeg": 0, "label": null, "attached_to": null, "device_id": null, "allocation_mode": null },
          { "id": "other-side", "catalog_item_rev_id": "cabinet", "position": [1300, -500, 0], "rotation_ddeg": 0, "label": null, "attached_to": null, "device_id": null, "allocation_mode": null }
        ]
      },
      "expect": [{ "code": "item_in_door_swing", "element_id": "in-swing", "severity": "warning" }]
    },
    {
      "name": "a sliding door doesn't swing",
      "plan": {
        "walls": [{ "id": "w1", "a": [0, 0], "b": [4000, 0], "thickness_mm": 150, "height_mm": 3000 }],
        "openings": [
          { "id": "door", "wall_id": "w1", "type": "door", "offset_mm": 1000, "width_mm": 900, "height_mm": 2100, "sill_mm": 0, "swing": "sliding" }
        ],
        "objects": [
          { "id": "c1", "catalog_item_rev_id": "cabinet", "position": [1300, 500, 0], "rotation_ddeg": 0, "label": null, "attached_to": null, "device_id": null, "allocation_mode": null }
        ]
      },
      "expect": []
    },
    {
      "name": "a cabinet over a column; one only touching its side is fine",
      "plan": {
        "columns": [{ "id": "col", "footprint": [[0, 0], [400, 0], [400, 400], [0, 400]], "height_mm": 3000 }],
        "objects": [
          { "id": "over", "catalog_item_rev_id": "cabinet", "position": [500, 200, 0], "rotation_ddeg": 0, "label": null, "attached_to": null, "device_id": null, "allocation_mode": null },
          { "id": "beside", "catalog_item_rev_id": "cabinet", "position": [-210, 200, 0], "rotation_ddeg": 0, "label": null, "attached_to": null, "device_id": null, "allocation_mode": null }
        ]
      },
      "expect": [{ "code": "item_over_column", "element_id": "over", "severity": "warning" }]
    },
    {
      "name": "seats without a label",
      "plan": {
        "objects": [
          { "id": "unlabelled", "catalog_item_rev_id": "desk", "position": [0, 0, 0], "rotation_ddeg": 0, "label": null, "attached_to": null, "device_id": null, "allocation_mode": "assigned" },
          { "id": "labelled", "catalog_item_rev_id": "desk", "position": [3000, 0, 0], "rotation_ddeg": 0, "label": "A-01", "attached_to": null, "device_id": null, "allocation_mode": "assigned" }
        ]
      },
      "expect": [{ "code": "seat_without_label", "element_id": "unlabelled", "severity": "warning" }]
